{
  "name": "brasa-business",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health", "/operator/*", "/operator-marketplace", "/operator-marketplace.html"]
  },
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 }, "traces": { "enabled": true, "head_sampling_rate": 0.05 } },
  "env": {
    "production": {
      "name": "brasa-business-powered-production",
      "workers_dev": true,
      "triggers": { "crons": ["17 3 * * *"] },
      "d1_databases": [{ "binding": "PROVIDERS_DB", "database_name": "brasa-business-marketplace-production", "database_id": "61e0e794-30d2-4e52-a891-b9a1b46d3320", "migrations_dir": "migrations" }],
      "vars": { "EDUCATION_PUBLIC_ORIGIN": "https://brasa-education-powered-production.richard-bad.workers.dev" },
      "services": [
        { "binding": "EDUCATION", "service": "brasa-education-powered-production" },
        { "binding": "GOVERNMENT", "service": "brasa-government-powered-production" }
      ]
    },
    "staging": {
      "name": "brasa-business-staging",
      "workers_dev": true,
      "triggers": { "crons": ["17 3 * * *"] },
      "d1_databases": [{
        "binding": "PROVIDERS_DB",
        "database_name": "brasa-business-marketplace-staging",
        "database_id": "5fdc0082-ccb0-47cb-a3a9-a3d25875bbd4",
        "migrations_dir": "migrations"
      }],
      "vars": { "EDUCATION_PUBLIC_ORIGIN": "https://brasa-education-staging.richard-bad.workers.dev" },
      "services": [
        { "binding": "IDENTITY", "service": "brasa-identity-staging" },
        { "binding": "EDUCATION", "service": "brasa-education-staging" },
        { "binding": "GOVERNMENT", "service": "brasa-government-staging" }
      ]
    }
  }
}
